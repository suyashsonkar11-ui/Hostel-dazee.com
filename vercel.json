{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.cjs": { "runtime": "nodejs22.x" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.cjs?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
